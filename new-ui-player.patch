+/** How strongly a line at this distance from the current one is dimmed. */
+private fun dimFor(distance: Int): Float =
+  when (distance) {
+    0 -> 1F
+    1 -> 0.56F
+    2 -> 0.4F
+    3 -> 0.3F
+    else -> 0.24F
+  }
+
+private fun blurFor(
+  distance: Int,
+  amount: Float,
+): Float =
+  when {
+    distance <= 1 -> 0F
+    distance == 2 -> amount / 3
+    distance == 3 -> amount * 2 / 3
+    else -> amount
+  }
